---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writeups'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base>
  <div class="term">
    <p><span class="prompt">$</span>whoami</p>
    <p class="out">Mateo Aja Moral (zodiak)</p>
    <p><span class="prompt">$</span>cat role.txt</p>
    <p class="out">SRE at Fever. I used to run cloud, Kubernetes and WAF; now I attack them.</p>
    <p><span class="prompt">$</span>cat goal.txt</p>
    <p class="out">Web application and cloud infrastructure pentesting.</p>
    <p class="cursor"><span class="prompt">$</span></p>
  </div>

  <h2>What I do</h2>
  <ul class="list">
    <li><span class="muted">web</span><span>Web application pentesting</span></li>
    <li><span class="muted">cloud</span><span>AWS, GCP and Kubernetes security</span></li>
    <li><span class="muted">waf</span><span>WAF rule review and hardening</span></li>
  </ul>

  <h2>Latest writeups</h2>
  <ul class="list">
    {posts.map((p) => (
      <li>
        <span class="muted">{fmt(p.data.date)}</span>
        <span><span class="tag">[{p.data.platform}]</span><a href={`/writeups/${p.id}/`}>{p.data.title}</a>{p.data.locked && <span class="muted"> (active)</span>}</span>
      </li>
    ))}
  </ul>
  <p><a href="/writeups/">View all writeups</a></p>
</Base>
