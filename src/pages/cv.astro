        <li>Providing high-level support to customers and businesses managing their resources within Google Cloud Platform</li>
      </ul>
    </div>

    <h2>Skills</h2>
    <ul class="chips">{skills.map((s) => <li>{s}</li>)}</ul>

    <h2>Certificates</h2>
    <ul class="list">
      <li><span class="muted">Feb 2024 to Feb 2026</span><span>GCP Professional Cloud Architect</span></li>
      <li><span class="muted">Oct 2024 to Oct 2026</span><span>CKA: Certified Kubernetes Administrator</span></li>
