---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('Missing src/content/cv/cv.md');
const { Content, headings } = await render(entry);
// Solo los "##" van al índice. Cambia a h.depth <= 3 para incluir también los "###".
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={`CV | ${entry.data.title}`}>
  <div class="layout">
    <div>
      <h1>{entry.data.title}</h1>
      <p class="muted">{entry.data.role}</p>
      <p class="muted">{entry.data.location}</p>

      {toc.length > 0 && (
        <details class="toc-mobile noprint">
          <summary>Contents</summary>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </details>
      )}

      <div class="cv"><Content /></div>
    </div>

    {toc.length > 0 && (
      <aside class="toc-side noprint" aria-label="CV contents">
        <nav>
          <p class="muted">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Base>

<style>
  .layout { position: relative; }

  .cv :global(h3) { font-size: 1rem; margin: 1.5rem 0 0; }
  .cv :global(h3 + p) { color: var(--muted); margin-top: 0; }
  .cv :global(ul) { margin: .4rem 0 0; padding-left: 1.2rem; }
  .cv :global(h2), .cv :global(h3) { scroll-margin-top: 1.5rem; }

  .toc-side ul, .toc-mobile ul { list-style: none; margin: .5rem 0 0; padding: 0; }
  li.d3 { padding-left: 1rem; }
  .toc-side li a, .toc-mobile li a { display: block; padding: .15rem 0 .15rem .75rem; margin-left: -1px; border-left: 2px solid transparent; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .toc-side li a:hover, .toc-mobile li a:hover { color: var(--text); text-decoration: none; }
  .toc-side li a.active { color: var(--accent); border-left-color: var(--accent); }

  .toc-side { display: none; }
  .toc-mobile { border: 1px solid var(--line); border-radius: 6px; background: var(--panel); padding: .5rem 1rem; margin: 1.5rem 0; }
  .toc-mobile summary { cursor: pointer; }

  @media (min-width: 80rem) {
    .toc-mobile { display: none; }
    .toc-side { display: block; position: absolute; top: 0; bottom: 0; left: calc(100% + 2rem); width: 15rem; }
    .toc-side nav { position: sticky; top: 1.5rem; max-height: calc(100vh - 3rem); overflow-y: auto; }
    .toc-side ul { border-left: 1px solid var(--line); }
  }

  @media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-side a')];
  const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.classList.remove('active'));
        byId.get(e.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '0px 0px -70% 0px' },
  );
  for (const id of byId.keys()) {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  }
</script>
