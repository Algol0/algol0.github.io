---
import '../styles/global.css';
const { title = 'zodiak', description = 'Pentesting, cloud y seguridad ofensiva' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header>
      <div class="wrap">
        <nav>
          <a class="brand" href="/">
            <img src="/logo.png" alt="" width="24" height="29" />
            <span>zodiak@sec:~$</span>
          </a>
          <a href="/writeups/" aria-current={path.startsWith('/writeups') ? 'page' : undefined}>writeups</a>
          <a href="/cv/" aria-current={path.startsWith('/cv') ? 'page' : undefined}>cv</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap">
      <a href="https://github.com/ZodiakDrinker">github</a>
      <a href="mailto:tu@correo.com">tu@correo.com</a>
    </footer>
  </body>
</html>
